# ============================================================
# AI Learning & Study Assistant - Environment Configuration
# ============================================================
# Copy this file to ".env" and fill in your own values.
# NEVER commit your real .env file to version control.

# Your LLM provider API key.
# If this is left blank or missing, the application automatically
# runs in DEMO MODE using local/offline logic - it will NOT crash.
LLM_API_KEY=your_api_key_here

# Which LLM provider to use: "anthropic" or "openai"
LLM_PROVIDER=anthropic

# Model name for the chosen provider
LLM_MODEL=claude-3-5-sonnet-20241022

# Embedding model used for RAG (Sentence Transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Number of chunks to retrieve for RAG (top-K)
RAG_TOP_K=4

# Chunk size / overlap for document splitting (characters)
CHUNK_SIZE=800
CHUNK_OVERLAP=120
